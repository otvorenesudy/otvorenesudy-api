<%= form_with model: invite, id: 'invite-form', class: 'invite-form row' do |f| %>
  <%= hidden_field_tag :l, I18n.locale %>
  <%= f.hidden_field :locale, value: I18n.locale %>

  <div class="col-sm-8 offset-sm-2 col-md-6 offset-md-3">
    <div class="input-group">
      <%= f.text_field :email, class: class_names('form-control', error: invite.errors.any?), placeholder: t('.invite_placeholder') %>
      <%= f.submit t('.invite_button'), track(:invite, :create, nil, class: 'btn') %>
    </div>
  </div>
<% end %>
