# Development credentials, all optional: the app runs without any. To try a service locally, copy what you need into
# your own encrypted file with `bin/rails credentials:edit --environment development` (git ignores it and its key).
# Production's are in config/credentials/production.yml.enc; config/initializers/production_boot_check.rb lists the
# ones production can't run without.

# Signs sessions and cookies; Rails makes one for development (tmp/local_secret.txt) when this is missing.
# secret_key_base: ...

# Errors and traces, sent to Sentry only when a DSN is set.
# sentry:
#   dsn: https://<key>@<organization>.ingest.sentry.io/<project>
#   traces_sample_rate: 0.1

# The Sidekiq dashboard at /sidekiq; without a password it stays locked.
# sidekiq:
#   password: ...

# Performance monitoring, sent to Skylight only with a token.
# skylight:
#   token: ...
