#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up or updates the development environment; safe to run again at any time. `bin/setup --skip-server` doesn't
# start bin/dev at the end.
require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*)
  system(*, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts '== Installing dependencies =='
  system! 'git submodule update --init'
  system('bundle check') || system!('bundle install')
  system! 'npm install --no-audit --no-fund'

  puts "\n== Installing git hooks =="
  system! 'bin/leaks --install'

  # dotenv's settings for development and the specs, which git ignores, from their committed examples. A file that is
  # already there is yours: it is never overwritten.
  puts "\n== Copying dotenv files =="
  { '.env.example' => '.env', '.env.test.example' => '.env.test' }.each do |example, file|
    next if File.exist?(file)

    FileUtils.cp example, file
    puts "#{example} -> #{file}"
  end

  puts "\n== Preparing databases =="
  system! 'bin/rails db:prepare'

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails log:clear tmp:clear'

  unless ARGV.include?('--skip-server')
    puts "\n== Starting development server =="
    $stdout.flush
    exec 'bin/dev'
  end
end
