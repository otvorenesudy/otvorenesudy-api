.bundle
.idea
.project
.sass-cache
.tags

.~lock.*
*.*~

Gemfile.lock.tags

/tags

/db/*.sqlite3
/log/*
/tmp/*

!/log/.keep
!/tmp/.keep

# Rails credentials' keys (production's encrypted file is committed). Each developer keeps their own development
# credentials, from config/credentials/development.example; the tests and CI need none.
/config/master.key
/config/credentials/*.key
/config/credentials/development.*
!/config/credentials/development.example
/config/credentials/test.*

# dotenv: .env and .env.test are each checkout's own, made from the committed .env.example and .env.test.example
# (bin/setup copies them); .env.local and .env.*.local hold personal overrides. CI uses the committed .env.ci as
# .env.test, and the server keeps its own .env.
/.env
/.env.local
/.env.*.local
/.env.test

# Node tooling (Prettier, esbuild, the libraries bin/vendor copies), Dart Sass builds and coverage reports
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/coverage/

__pycache__
ml/decree-embeddings/models/*
!ml/decree-embeddings/models/.gitkeep
ml/decree-embeddings/data/*
!ml/decree-embeddings/data/.gitkeep

./scripts

# Claude Code: personal settings and agent worktrees
/.claude/settings.local.json
/.claude/worktrees/
