# dotenv: .env and .env.test are each checkout's own, made from the committed .env.example and .env.test.example
# (bin/setup copies them); .env.local and .env.*.local hold personal overrides. CI uses the committed .env.ci as
# .env.test, and the server keeps its own .env.
/.env
/.env.local
/.env.*.local
/.env.test

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

/config/credentials/development.key

/config/credentials/test.key

/config/credentials/production.key

__pycache__
ml/decree-embeddings/models/*
!ml/decree-embeddings/models/.gitkeep
ml/decree-embeddings/data/*
!ml/decree-embeddings/data/.gitkeep

./scripts

